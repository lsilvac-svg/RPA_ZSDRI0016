# Copiar como .env y completar. El archivo .env no se sube al repositorio.
# Toda la configuración de robots, conexiones SAP y usuarios se administra
# desde la interfaz web; aquí solo van los valores propios del equipo.

# --- Plataforma Django ---
# Generar con: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# 1 solo en desarrollo
DJANGO_DEBUG=0
# Nombres o IPs con los que se accede a la web, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Clave para cifrar las contraseñas SAP en la BD. Generar con:
#   python manage.py generar_clave_cifrado
# Si se pierde o cambia, hay que volver a ingresar las contraseñas SAP.
RPA_CLAVE_CIFRADO=

# --- Acceso ---
# Solo pueden ingresar correos de este dominio
DOMINIO_CORREO=ipesa.com.pe
SUPERADMIN_EMAIL=lsilvac@ipesa.com.pe
